# DOMAIN i środowisko
DOMAIN=localhost
FRONTEND_HOST=http://localhost:5173
ENVIRONMENT=local

# Nazwa projektu
PROJECT_NAME="Full Stack FastAPI Project"
STACK_NAME=full-stack-fastapi-project

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Email (opcjonalne)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Baza danych - ważne: POSTGRES_SERVER to "db", nie localhost!
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=testdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# Nazwy obrazów Docker (ci = continuous integration)
DOCKER_IMAGE_BACKEND=backend-ci
DOCKER_IMAGE_FRONTEND=frontend-ci

# Inne
SENTRY_DSN=
